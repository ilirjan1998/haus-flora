# Kopiere diese Datei zu ".env" und trage echte Werte ein.
SECRET_KEY=hier-einen-langen-zufaelligen-schluessel-eintragen
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Gmail-Versand (App-Passwort noetig, siehe README)
EMAIL_HOST_USER=markajflore@gmail.com
EMAIL_HOST_PASSWORD=
OWNER_EMAIL=markajflore@gmail.com

# Privater Booking.com-Exportlink (niemals veröffentlichen)
BOOKING_ICAL_URL=
BOOKING_ICAL_SYNC_MINUTES=30

# Erst beim öffentlichen Start: endgültige HTTPS-Domain ohne Pfad eintragen,
# dann SEO_INDEXABLE=True setzen. Vorschau-Exporte bleiben immer noindex.
SITE_URL=
SEO_INDEXABLE=False
# Optional: echter HTML-Verifizierungscode aus der Google Search Console.
GOOGLE_SITE_VERIFICATION=
